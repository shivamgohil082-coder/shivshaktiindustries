# =================================================================
# SHIV SHAKTI INDUSTRIES - ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy this file to .env.local for local development.
# Configure these variables in your hosting provider (e.g. Vercel / cPanel / VPS).

# --- MySQL / MariaDB Database Connection ---
# If credentials are provided, the system runs on live MySQL.
# If omitted, it automatically falls back to secure zero-dependency local persistent storage.
DB_HOST="localhost"
DB_PORT=3306
DB_USER="shivshakti_user"
DB_PASSWORD="your-strong-database-password"
DB_NAME="shivshakti_db"

# --- Admin Authentication & Session Security ---
# Required HMAC session-signing key: use a unique random value of 32+ characters.
ADMIN_SECRET_KEY=""
# Private Owner Access Portal route (keep confidential, never expose)
OWNER_ACCESS_PATH="/owner-access-7x9k"
# Optional seed password for the first local JSON-backed admin account.
# Use a unique password with at least 12 characters. Never commit actual secrets.
ADMIN_INITIAL_PASSWORD=""

# --- SMTP Transactional Email (Brevo / SendGrid / Google Workspace) ---
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-login-email"
SMTP_PASS="your-smtp-key-or-app-password"

# --- Department-Specific Recipient & Sender Routing ---
# RFQ / Request a Quote inquiries:
SMTP_RFQ_EMAIL="rfq@shivshaktiindustries.org"

# General inquiries, job/career applications, supplier & vendor proposals:
SMTP_INFO_EMAIL="info@shivshaktiindustries.org"

# Default fallback recipient:
SMTP_TO_EMAIL="info@shivshaktiindustries.org"

# Default transactional sender identity:
SMTP_FROM_EMAIL='"Shiv Shakti Industries" <info@shivshaktiindustries.org>'

# --- Public Canonical URL ---
NEXT_PUBLIC_SITE_URL="https://shivshaktiindustries.org"
